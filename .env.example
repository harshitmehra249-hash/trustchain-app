# ==========================================
# TRUSTCHAIN - ENVIRONMENT CONFIGURATION
# ==========================================

# Database Configuration
DATABASE_URL=postgresql://trustchain:trustchain@localhost:5432/trustchain
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_EXPIRY=3600

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=420
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS=*

# Blockchain Configuration
POLYGON_RPC_URL=https://rpc-mumbai.maticvigil.com
POLYGON_CHAIN_ID=80001
PRIVATE_KEY=your-wallet-private-key-here
SUPPLY_CHAIN_CONTRACT_ADDRESS=

# AI/ML Configuration
OPENAI_API_KEY=sk-
HUGGINGFACE_API_KEY=hf_
YOLOv8_MODEL_PATH=models/yolov8n.pt
WHISPER_MODEL_PATH=models/ggml-base.bin

# Monitoring & Error Tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@trustchain-app.dev
SMTP_FROM_NAME=TrustChain

# Application Settings
APP_NAME=TrustChain
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_APP_NAME=TrustChain
VITE_APP_VERSION=1.0.0

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=900

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json

# Mesh Network Configuration
MESH_HEARTBEAT_INTERVAL=30
MESH_WEBSOCKET_TIMEOUT=60
MESH_MESSAGE_RETRY_ATTEMPTS=3
MESH_MESSAGE_RETRY_DELAY=5

# Supply Chain Configuration
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8080

# OAuth Configuration (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback/github
